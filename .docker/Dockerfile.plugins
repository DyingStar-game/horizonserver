# ----------------------------------------------------------- #
# Dockerfile.plugins — Builds only the ds_* plugin .so files  #
# Used by Skaffold for local dev (split build mode)            #
# ----------------------------------------------------------- #
FROM rust:1.94.1-bookworm AS builder

WORKDIR /build

# Copy root workspace definition (lock pins a compatible libwebrtc/webrtc-sys pair)
COPY Cargo.toml .
COPY Cargo.lock .

# Copy plugin source crates
COPY ds_common/ ds_common/
COPY ds_game_server/ ds_game_server/
COPY ds_player_authentication/ ds_player_authentication/
# ds_genericprops carries ~5.4MB of JSON data that this image never ships (the
# final stage keeps only the .so files). Copying the whole crate would let a
# JSON edit invalidate this layer and re-run the Rust build for nothing, so
# take only what the compiler needs. Safe: the crate has no build.rs and no
# include_str!/include_dir!.
COPY ds_genericprops/Cargo.toml ds_genericprops/Cargo.toml
COPY ds_genericprops/src/ ds_genericprops/src/
COPY ds_props/ ds_props/
COPY ds_services/ ds_services/
COPY ds_audio/ ds_audio/
COPY ds_bridge/ ds_bridge/

# Copy Horizon workspace (needed for horizon_event_system dependency resolution)
COPY Horizon/ Horizon/

# Build all plugins and collect .so output files
RUN --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    RUSTFLAGS="" cargo build --locked --release && \
    mkdir -p /plugins && \
    cp target/release/*.so /plugins/

# Minimal runtime image for init container use
FROM busybox:1.37
COPY --from=builder /plugins/ /plugins/
