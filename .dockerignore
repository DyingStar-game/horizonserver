# The Docker build context is the repo root. Horizon/ is a submodule now (no
# longer gitignored), so without these its build artifacts — hundreds of MB of
# compiled plugins and target/ — would be uploaded to the daemon on every build.
Horizon/target
Horizon/plugins
Horizon/logs
Horizon/.git
target
tests/node_modules
.git

# Dead ds_genericprops data: referenced by no code, but 2.7MB of build context
# on every build and — before .docker/Dockerfile.data existed — a spurious
# rebuild trigger. Does not match startup_items.json, which is still shipped.
ds_genericprops/startup_items_rocks.json
ds_genericprops/startup_items copy.json
